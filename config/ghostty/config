# Ghostty is a fast, feature-rich, and cross-platform terminal emulator that uses platform-native UI and GPU acceleration.
# https://ghostty.org/docs/config/reference

# Theme
theme = catppuccin-mocha
bold-is-bright = true

# Window Settings
title = ""
window-save-state = always
window-colorspace = "display-p3"
window-decoration = false
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-theme = auto
adjust-cell-width = -1

###############
## clipboard ##
###############
clipboard-read = "allow"
clipboard-trim-trailing-spaces = true
clipboard-write = "allow"

# Font Settings
font-family = 'CaskaydiaCove Nerd Font'
font-size = 12
font-style = bold
font-feature = +liga
cursor-style = block
cursor-invert-fg-bg = true
font-thicken = true

macos-icon = "custom-style"
macos-icon-frame = "plastic"
macos-icon-ghost-color = "#1E1E2F"
macos-icon-screen-color = "#1E1E2F"

clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

mouse-hide-while-typing = true

# treat Option as Alt so tmux Meta bindings (M-a etc.) work
macos-option-as-alt = true

# make SUPER+A result in x02, which is C-b for tmux
keybind = ctrl+alt+shift+super+a=text:\x02

# keybind = ctrl+alt+shift+super+g=text:\x02g   # lazygit popup
# keybind = ctrl+alt+shift+super+s=text:\x02s   # session picker
# keybind = ctrl+alt+shift+super+f=text:\x02f   # fleet pane
